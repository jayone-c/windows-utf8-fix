# PowerShell (ignore by default; allow-list specific entry-point scripts)
*.psm1
*.psd1
# Top-level install.ps1 and scripts/sync-agents-md.ps1 are tracked explicitly

# Backup files (auto-created by install.ps1)
*.utf8fix-bak-*
*.bak
*.orig

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Windows
[Bb]in/
[Oo]bj/
*.user
*.suo

# Test
*.log
test-output/

# Exceptions (allow specific tracked scripts)
!install.ps1
